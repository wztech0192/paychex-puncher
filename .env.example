# Local browser executable override
CHROME_PATH=

# Telegram bot configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
TELEGRAM_GROUP_TITLE=Punch
TELEGRAM_BOT_USERNAME=@your_bot_username
TELEGRAM_LISTENER_HEADLESS=false

# OpenAI / Vercel AI SDK configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-6.1-terra

# Paychex credentials and default direct action
PAYCHEX_USERNAME=your-paychex-username
PAYCHEX_PASSWORD=your-paychex-password
PAYCHEX_ACTION=clockOut
PAYCHEX_LOGIN_URL="https://myapps.paychex.com/landing_remote/login.do?lang=en&landingRedirect=true#?mode=employee&app=XXX&clients=XXX"

# Logging
LOG_LEVEL=info
